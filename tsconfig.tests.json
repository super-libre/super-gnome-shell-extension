{
    // Type-checks the tests and the Node tools, which run under Node, not GJS.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "noEmit": true,
        "types": ["node"],
        "allowImportingTsExtensions": true
    },
    "include": ["tests/**/*.ts", "tools/**/*.ts", "src/core/**/*.ts", "vitest.config.ts"]
}
